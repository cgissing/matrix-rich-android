<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/rich_bubble_tail_size">
        <shape android:shape="rectangle">
            <solid android:color="@color/rich_message_bg_incoming" />
            <corners
                android:bottomLeftRadius="@dimen/rich_bubble_radius"
                android:bottomRightRadius="@dimen/rich_bubble_radius"
                android:topRightRadius="@dimen/rich_bubble_radius" />
        </shape>
    </item>
    <item android:gravity="top|left">
        <vector
            android:width="@dimen/rich_bubble_tail_size"
            android:height="@dimen/rich_bubble_tail_size"
            android:viewportWidth="10"
            android:viewportHeight="10">
            <path
                android:fillColor="@color/rich_message_bg_incoming"
                android:pathData="M0,0 L10,10 L10,0 Z" />
        </vector>
    </item>
</layer-list>
